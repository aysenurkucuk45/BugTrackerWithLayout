@model BugTrackerWithLayout.ViewModels.RegisterViewModel

@{
    ViewBag.Title = "Kayıt Ol";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 auth-bg">
    <div class="card shadow-lg border-0 p-4" style="max-width: 420px; width:100%; border-radius: 20px;">
        <div class="text-center mb-4">
            <h1 class="fw-bold text-success" style="font-size: 2rem;">Kayıt Ol</h1>
            <p class="text-muted" style="font-size: .95rem;">Hemen aramıza katılın </p>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "mt-2" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3 small" })

            <div class="form-floating mb-3">
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control rounded-pill", placeholder = "Kullanıcı Adı", autocomplete = "username" })
                <label>Kullanıcı Adı</label>
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger small" })
            </div>

            <div class="form-floating mb-3">
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control rounded-pill", type = "email", placeholder = "E-posta", autocomplete = "email" })
                <label>E-posta</label>
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
            </div>

            <div class="form-floating mb-3">
                @Html.PasswordFor(m => m.Password, new { @class = "form-control rounded-pill", placeholder = "Şifre", autocomplete = "new-password" })
                <label>Şifre</label>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
            </div>

            <div class="form-floating mb-3">
                @Html.TextBoxFor(m => m.DisplayName, new { @class = "form-control rounded-pill", placeholder = "Profil Adı" })
                <label>Profil Adı</label>
                @Html.ValidationMessageFor(m => m.DisplayName, "", new { @class = "text-danger small" })
                <small class="text-muted">Boş bırakırsanız kullanıcı adınız görünecek.</small>
            </div>

            <div class="mb-3">
                @Html.Label("Avatar", new { @class = "form-label fw-semibold" })
                @Html.DropDownListFor(
                    m => m.Avatar,
                    new SelectList((IEnumerable<string>)ViewBag.Avatars),
                    "Seçiniz",
                    new { @class = "form-select rounded-pill" }
                )
                <small class="text-muted d-block mt-1">Tweety, Bugs Bunny, Tom, Jerry</small>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 rounded-pill fw-semibold shadow-sm">
                ✔ Kayıt Ol
            </button>

            <div class="text-center mt-3">
                <small>Zaten hesabınız var mı?</small>
                @Html.ActionLink("Giriş Yap", "Login", "Account", null, new { @class = "ms-1 fw-semibold text-decoration-none text-primary" })
            </div>
        }
    </div>
</div>
