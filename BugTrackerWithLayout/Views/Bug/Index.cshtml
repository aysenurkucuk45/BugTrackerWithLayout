@model BugTrackerWithLayout.ViewModels.BugListFilterViewModel
@using PagedList.Mvc

@{
    ViewBag.Title = "Hata Takip Listesi";
}

<h2 class="mb-4">Bütün Hatalar</h2>

<!-- 🔍 FİLTRE / ARAMA / SAYFA BOYUTU / EXPORT -->
@using (Html.BeginForm("Index", "Bug", FormMethod.Get, new { @class = "form-inline", role = "form", id = "filterForm" }))
{
    <input type="hidden" name="page" id="pageInput" value="@Model.Page" />

    <div class="panel panel-default" style="padding:10px; margin-bottom:15px;">
        <div class="row" style="margin-bottom:8px;">
            <div class="col-sm-3" style="margin-bottom:6px;">
                <input type="text" name="Keyword" value="@Model.Keyword" class="form-control filter-field" placeholder="Başlık/Açıklama ara" />
            </div>
            <div class="col-sm-2" style="margin-bottom:6px;">
                @Html.DropDownListFor(m => m.Status, new SelectList(Model.Statuses, "Value", "Text", Model.Status), "Durum", new { @class = "form-control filter-field" })
            </div>
            <div class="col-sm-2" style="margin-bottom:6px;">
                @Html.DropDownListFor(m => m.Priority, new SelectList(Model.Priorities, "Value", "Text", Model.Priority), "Öncelik", new { @class = "form-control filter-field" })
            </div>
            <div class="col-sm-2" style="margin-bottom:6px;">
                @Html.DropDownListFor(m => m.CategoryId, new SelectList(Model.Categories, "Value", "Text", Model.CategoryId), "Kategori", new { @class = "form-control filter-field" })
            </div>
            <div class="col-sm-1" style="margin-bottom:6px;">
                <select name="pageSize" class="form-control" title="Sayfa boyutu" id="pageSizeSelect">
                    @{
                        var sizes = new[] { 5, 10, 20, 50 };
                        foreach (var s in sizes)
                        {
                            <option value="@s" @(Model.PageSize == s ? "selected" : "")>@s</option>
                        }
                    }
                    <option value="99999" @(Model.PageSize >= 99999 ? "selected" : "")>Hepsi</option>
                </select>
            </div>
        </div>

        <div class="row" style="margin-bottom:8px;">
            <div class="col-sm-12 text-right">
                <button type="submit" class="btn btn-primary">
                    <i class="glyphicon glyphicon-filter"></i> Filtrele
                </button>
                <a class="btn btn-default" href="@Url.Action("Index","Bug")">
                    <i class="glyphicon glyphicon-remove"></i> Temizle
                </a>

                <!-- 📤 Excel ve PDF Export -->
                <a class="btn btn-success"
                   href="@Url.Action("ExportExcel","Bug", new {
                       keyword = Model.Keyword,
                       status = Model.Status,
                       priority = Model.Priority,
                       categoryId = Model.CategoryId
                   })">
                    <i class="glyphicon glyphicon-export"></i> Excel’e Aktar
                </a>

                <a class="btn btn-danger"
                   href="@Url.Action("ExportPdfDirect","Bug", new {
                       keyword = Model.Keyword,
                       status = Model.Status,
                       priority = Model.Priority,
                       categoryId = Model.CategoryId
                   })">
                    <i class="glyphicon glyphicon-file"></i> PDF’e Aktar
                </a>

                <a href="@Url.Action("Create")" class="btn btn-success">
                    <i class="glyphicon glyphicon-plus"></i> Yeni Hata Ekle
                </a>
            </div>
        </div>
    </div>
}

<table class="table table-bordered table-hover table-striped">
    <thead class="bg-dark text-white text-center">
        <tr>
            <th>Başlık</th>
            <th>Açıklama</th>
            <th>Öncelik</th>
            <th>Durum</th>
            <th>Bildiren</th>
            <th>İşlemler</th>
            <th>Kategori</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.PagedBugs != null && Model.PagedBugs.Any())
        {
            foreach (var item in Model.PagedBugs)
            {
                <tr>
                    <td class="align-middle">@item.Title</td>
                    <td class="align-middle">@item.Description</td>
                    <td class="text-center align-middle">
                        @if (item.Priority == "Yüksek")
                        {
                            <span class="badge bg-danger rounded-pill">Yüksek</span>
                        }
                        else if (item.Priority == "Orta")
                        {
                            <span class="badge bg-warning text-dark rounded-pill">Orta</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill">Düşük</span>
                        }
                    </td>
                    <td class="text-center align-middle">
                        @if (item.Status == "Açık")
                        {
                            <span class="badge bg-warning text-dark rounded-pill">Açık</span>
                        }
                        else if (item.Status == "Çözüldü")
                        {
                            <span class="badge bg-success rounded-pill">Çözüldü</span>
                        }
                        else if (item.Status == "Devam Ediyor")
                        {
                            <span class="badge bg-info text-dark rounded-pill">Devam Ediyor</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill">@item.Status</span>
                        }
                    </td>
                    <td class="align-middle">@item.ReportedBy</td>
                    <td class="text-center align-middle">
                        <div class="btn-group-vertical" role="group">
                            <a href="@Url.Action("Edit", new { id = item.Id })"
                               class="btn btn-sm btn-primary mb-1">
                                <i class="glyphicon glyphicon-edit"></i> Düzenle
                            </a>
                            <a href="@Url.Action("Delete", new { id = item.Id })"
                               class="btn btn-sm btn-danger mb-1">
                                <i class="glyphicon glyphicon-trash"></i> Sil
                            </a>
                            <a href="@Url.Action("AddSolution", new { id = item.Id })"
                               class="btn btn-sm btn-success">
                                <i class="glyphicon glyphicon-plus"></i> Çözüm Ekle
                            </a>
                        </div>
                    </td>
                    <td class="text-center align-middle">
                        @if (item.Category != null)
                        {
                            @item.Category.Name
                        }
                        else
                        {
                            <span class="text-muted fst-italic">Kategori Yok</span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="7" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
        }
    </tbody>
</table>

<!-- SAYFALAMA -->
<div class="d-flex justify-content-center mt-4">
    @if (Model.PagedBugs != null)
    {
        @Html.PagedListPager(
            Model.PagedBugs,
            page => Url.Action("Index", new
                 {
                page,
                pageSize = Model.PageSize,
                keyword = Model.Keyword,
                status = Model.Status,
                priority = Model.Priority,
                categoryId = Model.CategoryId
            }),
            new PagedListRenderOptions
            {
                Display = PagedListDisplayMode.IfNeeded,
                MaximumPageNumbersToDisplay = 5
            }
        )
    }
</div>
