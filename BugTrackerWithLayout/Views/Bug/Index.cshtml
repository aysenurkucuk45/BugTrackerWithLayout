@model PagedList.IPagedList<BugTrackerWithLayout.Models.Bug>
@using PagedList.Mvc
@{
    ViewBag.Title = "Hata Takip Listesi";
    var currentPageSize = ViewBag.CurrentPageSize ?? 5; // Controller dolduruyor
}

<h2 class="mb-3">Bütün Hatalar</h2>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div class="d-flex gap-2 align-items-center">
        <a href="@Url.Action("Create")" class="btn btn-success">Yeni Hata Ekle</a>

        <!-- Kaçarlı gösterilsin -->
        <form method="get" action="@Url.Action("Index")" class="d-inline-block ms-2">
            <input type="hidden" name="page" value="1" />
            <label class="me-1">Görünüm:</label>
            <select name="pageSize" class="form-select d-inline-block" style="width:auto;" onchange="this.form.submit()">
                @{
                    int[] sizes = new[] { 5, 10, 20, 50 };
                    foreach (var s in sizes)
                    {
                        <option value="@s" @(s == (int)currentPageSize ? "selected" : "")>@s</option>
                    }
                }
            </select>
        </form>
    </div>

    <!-- Export -->
    <div class="btn-group">
        <a class="btn btn-outline-primary export-btn" href="@Url.Action("ExportExcel", "Bug")"><span>Excel (CSV)</span></a>
        <a class="btn btn-outline-danger export-btn" href="@Url.Action("ExportPdf", "Bug")"><span>PDF</span></a>
    </div>
</div>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Başlık</th>
            <th>Açıklama</th>
            <th>Öncelik</th>
            <th>Durum</th>
            <th>Bildiren</th>
            <th>Tarih</th>
            <th class="text-center">İşlemler</th>
            <th>Kategori</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>
                    @if (item.Priority == "Yüksek")
                    {
                        <span class="badge bg-danger">Yüksek</span>
                    }
                    else if (item.Priority == "Orta")
                    {
                        <span class="badge bg-warning text-dark">Orta</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Düşük</span>
                    }
                </td>
                <td>
                    @if (item.Status == "Açık")
                    {
                        <span class="badge bg-warning text-dark">Açık</span>
                    }
                    else if (item.Status == "Çözüldü")
                    {
                        <span class="badge bg-success">Çözüldü</span>
                    }
                    else if (item.Status == "Devam Ediyor")
                    {
                        <span class="badge bg-info text-dark">Devam Ediyor</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Status</span>
                    }
                </td>
                <td>@item.ReportedBy</td>
                <td>@item.CreatedAt.ToShortDateString()</td>

                <!-- İşlemler dropdown -->
                <td class="text-center text-nowrap">
                    <div class="btn-group">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm actions-btn dropdown-toggle"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <span>İşlemler</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item"
                                   href="@Url.Action("Edit", new { id = item.Id })">
                                    Düzenle
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   href="@Url.Action("Details", new { id = item.Id })">
                                    Çözüm Ekle
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger"
                                   href="@Url.Action("Delete", new { id = item.Id })"
                                   onclick="return confirm('Bu hatayı silmek istediğinize emin misiniz?');">
                                    Sil
                                </a>
                            </li>
                        </ul>
                    </div>
                </td>

                <td>
                    @if (item.Category != null)
                    {
                        @item.Category.Name
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Kategori Yok</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Sayfalama -->
<div class="d-flex justify-content-center mt-4">
    @Html.PagedListPager(
        Model,
        page => Url.Action("Index", new { page, pageSize = currentPageSize }),
        new PagedListRenderOptions
        {
            Display = PagedListDisplayMode.IfNeeded,
            DisplayPageCountAndCurrentLocation = false,
            MaximumPageNumbersToDisplay = 5,
            DisplayLinkToFirstPage = PagedListDisplayMode.Never,
            DisplayLinkToLastPage = PagedListDisplayMode.Never,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Never,
            DisplayLinkToNextPage = PagedListDisplayMode.Never
        })
</div>

<style>
    /* Sayfalama düğmeleri için boşluk ve stil */
    .pagination {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

        .pagination > li > a,
        .pagination > li > span {
            margin: 0 6px;
            padding: 6px 12px;
            border-radius: 5px;
            border: 1px solid #dee2e6;
            color: #007bff;
            text-decoration: none;
        }

        .pagination > .active > a {
            background-color: #007bff;
            color: white;
            border-color: #007bff;
        }

        .pagination > li > a:hover {
            background-color: #e2e6ea;
        }

    /* İşlemler sütunu tek satır kalsın */
    td.text-nowrap {
        white-space: nowrap;
    }

    /* --- Görünmeyen buton metinlerini garanti et --- */
    .export-btn, .actions-btn {
        font-size: .9rem !important;
        font-weight: 600;
        letter-spacing: .1px;
    }

    .btn-outline-primary.export-btn {
        color: #0d6efd !important;
        border-color: #0d6efd !important;
    }

    .btn-outline-danger.export-btn {
        color: #dc3545 !important;
        border-color: #dc3545 !important;
    }

    .actions-btn {
        color: #6c757d !important;
        border-color: #6c757d !important;
        min-width: 110px;
    }
        /* Bazı temalarda ikon-only kuralı olabiliyor; yazıyı zorla göster */
        .actions-btn span, .export-btn span {
            display: inline !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
</style>
