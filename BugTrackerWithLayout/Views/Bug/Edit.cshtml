@model BugTrackerWithLayout.Models.Bug

@{
    ViewBag.Title = "Hata Güncelle";
}

<h2>Hata Güncelle</h2>

@using (Html.BeginForm("Edit", "Bug", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)

    <div class="form-group">
        @Html.LabelFor(model => model.Title)
        @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Description)
        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 3 })
    </div>

    <div class="form-group">
        @Html.Label("Priority")
        @Html.DropDownList("Priority", new SelectList(new[] { "Düşük", "Orta", "Yüksek" }, Model.Priority), new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Status")
        @Html.DropDownList("Status", new SelectList(new[] { "Açık", "Devam Ediyor", "Çözüldü" }, Model.Status), new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.ReportedBy)
        @Html.TextBoxFor(model => model.ReportedBy, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.CreatedAt)
        @Html.TextBoxFor(model => model.CreatedAt, new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="form-group">
        @Html.Label("Kategori")
        @Html.DropDownList("CategoryId", ViewBag.CategoryId as SelectList, "Kategori Seçiniz", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Dosya Güncelle</label>
        <input type="file" name="file" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Kaydet</button>
}
