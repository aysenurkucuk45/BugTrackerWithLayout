@model BugTrackerWithLayout.Models.Bug
@{
    ViewBag.Title = "Yeni Hata Ekle";
}

<div class="container mt-4">
    <!-- Başlık ve Geri Dön -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0 fw-bold text-primary">Yeni Hata Ekle</h2>
        <a href="@Url.Action("Index","Bug")" class="btn btn-sm btn-success fw-bold">
            ← Geri Dön
        </a>
    </div>

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="card shadow-sm rounded-3 border-0">
        <div class="card-body p-4">
            @using (Html.BeginForm("Create", "Bug", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Başlık -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-dark">Başlık <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control border-primary shadow-sm", placeholder = "Örn: Koyu temada buton metni görünmüyor" })
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Açıklama -->
                    <div class="col-12">
                        <label class="form-label fw-semibold text-dark">Açıklama <span class="text-danger">*</span></label>
                        @Html.TextAreaFor(m => m.Description, 5, 0, new { @class = "form-control border-info shadow-sm", placeholder = "Adımlar, beklenen/gerçekleşen sonuçlar ve varsa hata mesajı..." })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Öncelik -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Öncelik</label>
                        @Html.DropDownListFor(m => m.Priority, ViewBag.PriorityList as SelectList, "Öncelik Seçiniz", new { @class = "form-select border-warning shadow-sm" })
                    </div>

                    <!-- Durum -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Durum</label>
                        @Html.DropDownListFor(m => m.Status, ViewBag.StatusList as SelectList, "Durum Seçiniz", new { @class = "form-select border-success shadow-sm" })
                    </div>

                    <!-- Kategori -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Kategori <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.CategoryId, ViewBag.CategoryId as SelectList, "Kategori Seçiniz", new { @class = "form-select border-secondary shadow-sm" })
                        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Dosya -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Dosya / Ekran Görüntüsü</label>
                        <input type="file" name="file" class="form-control border-info shadow-sm" />
                        <div class="form-text text-muted">PNG, JPG veya PDF • maks. 5MB</div>
                    </div>

                    <!-- Butonlar -->
                    <div class="col-12 d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow">
                            ✅ Kaydet
                        </button>
                        <a href="@Url.Action("Index","Bug")" class="btn btn-danger fw-bold px-4 shadow">
                            ❌ İptal
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
